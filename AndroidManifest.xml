<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.tvkeys"
    android:versionCode="9"
    android:versionName="1.8">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <!-- Development permission, granted over adb; used to follow WindowManager's key log. -->
    <uses-permission android:name="android.permission.READ_LOGS" />

    <application android:label="TV Keys" android:allowBackup="false">
        <service
            android:name=".KeyService"
            android:label="TV Keys"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>
    </application>
</manifest>
